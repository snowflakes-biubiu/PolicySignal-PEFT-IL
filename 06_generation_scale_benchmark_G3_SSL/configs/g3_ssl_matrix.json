{
  "version": "1.0",
  "phase": "06_generation_scale_benchmark_G3_SSL",
  "stage": "G3-SSL",
  "title": "G3-SSL Level-2 半监督去噪 Scaling：异构双模型一致性伪标签 + 两阶段金标准精调",
  "seed": 42,
  "task": "task2_level2",
  "labels": ["B", "Y", "C", "G"],
  "gold_per_class": 300,
  "val_total": 400,
  "ssl_tiers": [500, 800, 1200],
  "epochs": 3,
  "polish_epochs": 1,
  "polish_lr_factor": 0.2,
  "silver_weight": 0.5,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_scope": "attn_mlp",
  "warmup_ratio": 0.05,
  "pool": {
    "corpus_file": "CN_DOCS_FINAL_complete.parquet",
    "text_column": "Paragraph_content",
    "doc_column": "DocumentID",
    "filter_column": "R_1",
    "filter_value": "W",
    "max_para_per_doc": 4,
    "min_char_len": 20,
    "max_char_len": 768,
    "candidate_pool_size": 16000,
    "min_single_prob": 0.65,
    "min_mean_prob": 0.75,
    "high_conf_threshold": 0.90,
    "high_conf_ratio": 0.70
  },
  "models": [
    {
      "id": "chinese_roberta_large",
      "label": "编码器全参 (0.33B)",
      "runner": "encoder",
      "model": "hfl/chinese-roberta-wwm-ext-large",
      "precision": "bf16",
      "lr": 0.00002,
      "batch_size": 8,
      "grad_accum": 1,
      "eval_batch_size": 32,
      "max_length": 512,
      "gradient_checkpointing": false
    },
    {
      "id": "qwen3_4b_bf16_r8",
      "label": "中尺寸主力 (4B r8)",
      "runner": "peft",
      "model": "Qwen/Qwen3-4B",
      "precision": "bf16",
      "lr": 0.0002,
      "batch_size": 4,
      "grad_accum": 1,
      "eval_batch_size": 8,
      "max_length": 768,
      "gradient_checkpointing": true
    }
  ],
  "regimes": [
    {
      "id": "ssl_co_mix",
      "label": "异构伪标签+降权混合",
      "silver_weight": 0.5,
      "polish": false
    },
    {
      "id": "ssl_co_polish",
      "label": "异构伪标签+金标准精调",
      "silver_weight": 0.5,
      "polish": true
    }
  ]
}
